{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@elodia/web...",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "API_URL" }]
    },
    "backend": {
      "root": "apps/api",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@elodia/api..."
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
