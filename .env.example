# Copy to .env (never commit .env)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose to the frontend.
SUPABASE_SECRET_KEY=
# Pooler connection (runtime), e.g. postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DATABASE_URL=
# Direct connection (migrations)
DIRECT_URL=

# API (apps/api). All optional in development.
PORT=4000
# Comma-separated list of allowed web origins (CORS).
WEB_ORIGIN=http://localhost:3000
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Auth (apps/api)
# base64 of 32 random bytes; encrypts TOTP secrets at rest. Generate: openssl rand -base64 32
# (required in production; needed locally only to use two-factor authentication)
APP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Failed-attempt budget per client IP per minute on POST /auth/login
LOGIN_RATE_LIMIT=5
# Reverse-proxy hops to trust for the client IP (leave empty if not behind a proxy)
TRUST_PROXY=
