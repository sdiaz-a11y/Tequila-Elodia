# Copy the values to apps/web/.env.local (never commit it) and to Vercel > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed to create users from the Equipo screen.
SUPABASE_SECRET_KEY=
# Root .env only (scripts/db-apply.mjs): direct Postgres connection for migrations.
DIRECT_URL=

# Correo saliente (cotizaciones). Opcional: sin esto el botón "Enviar por correo" no aparece.
# Cuenta en https://resend.com con el dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=
