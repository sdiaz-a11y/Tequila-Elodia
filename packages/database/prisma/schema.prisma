// ELODIA OS — Sprint 1.2: identity + CRM base. See docs/DATABASE.md.
// Later modules (territories, distributors, sales, inventory...) are added in their own sprints.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  invited
  disabled
}

enum PermissionScope {
  own
  team
  all
}

enum AccountType {
  prospect
  client
  distributor
  partner
  supplier
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  disqualified
}

enum OpportunityStatus {
  open
  won
  lost
}

enum ActivityType {
  call
  meeting
  email
  note
  task_followup
}

// ───────────── Identity & access ─────────────

model Organization {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  settings     Json     @default("{}")
  featureFlags Json     @default("{}") @map("feature_flags")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users          User[]
  roles          Role[]
  accounts       Account[]
  contacts       Contact[]
  leads          Lead[]
  pipelineStages PipelineStage[]
  opportunities  Opportunity[]
  activities     Activity[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  email            String
  passwordHash     String?    @map("password_hash")
  name             String
  status           UserStatus @default(invited)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  totpSecretEnc    String?    @map("totp_secret_enc")
  totpEnabledAt    DateTime?  @map("totp_enabled_at") @db.Timestamptz(6)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid(7)) @db.Uuid
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(own)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────── CRM base ─────────────

model Account {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  legalName      String?     @map("legal_name")
  rfc            String?
  type           AccountType @default(prospect)
  status         String      @default("active")
  ownerId        String?     @map("owner_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent        Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Account[]     @relation("AccountHierarchy")
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  convertedFrom Lead[]

  @@index([organizationId, type, status])
  @@index([organizationId, ownerId])
  @@map("accounts")
}

model Contact {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  accountId      String?   @map("account_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  roleTitle      String?   @map("role_title")
  isPrimary      Boolean   @default(false) @map("is_primary")
  ownerId        String?   @map("owner_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId, accountId])
  @@index([organizationId, email])
  @@map("contacts")
}

model Lead {
  id                 String     @id @default(uuid(7)) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  source             String?
  name               String
  company            String?
  email              String?
  phone              String?
  status             LeadStatus @default(new)
  ownerId            String?    @map("owner_id") @db.Uuid
  convertedAccountId String?    @map("converted_account_id") @db.Uuid
  convertedAt        DateTime?  @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  convertedAccount Account?     @relation(fields: [convertedAccountId], references: [id], onDelete: SetNull)
  activities       Activity[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("leads")
}

model PipelineStage {
  id                 String  @id @default(uuid(7)) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  name               String
  position           Int
  probabilityDefault Decimal @default(0) @map("probability_default") @db.Decimal(7, 4)
  isWon              Boolean @default(false) @map("is_won")
  isLost             Boolean @default(false) @map("is_lost")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([organizationId, position])
  @@map("pipeline_stages")
}

model Opportunity {
  id              String            @id @default(uuid(7)) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  accountId       String            @map("account_id") @db.Uuid
  pipelineStageId String            @map("pipeline_stage_id") @db.Uuid
  title           String
  amount          Decimal?          @db.Decimal(14, 2)
  currency        String            @default("MXN") @db.Char(3)
  probability     Decimal?          @db.Decimal(7, 4)
  expectedClose   DateTime?         @map("expected_close") @db.Date
  status          OpportunityStatus @default(open)
  lostReason      String?           @map("lost_reason")
  ownerId         String?           @map("owner_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  activities    Activity[]

  @@index([organizationId, status])
  @@index([organizationId, pipelineStageId])
  @@index([accountId])
  @@map("opportunities")
}

model Activity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  subject        String
  notes          String?
  dueAt          DateTime?    @map("due_at") @db.Timestamptz(6)
  doneAt         DateTime?    @map("done_at") @db.Timestamptz(6)
  ownerId        String?      @map("owner_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  leadId         String?      @map("lead_id") @db.Uuid
  opportunityId  String?      @map("opportunity_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, ownerId, dueAt])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@map("activities")
}

// ───────────── Audit (append-only; enforced by trigger in migration) ─────────────

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  resource       String
  resourceId     String?  @map("resource_id")
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resource, resourceId])
  @@map("audit_logs")
}
